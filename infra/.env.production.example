# ===== Stack de producción (docker-compose.prod.yml) =====
# Dominios (registros DNS A/AAAA apuntando al servidor). Caddy obtiene los certificados HTTPS.
WEB_DOMAIN=arena.tu-dominio.com
API_DOMAIN=api.arena.tu-dominio.com
ACME_EMAIL=admin@tu-dominio.com

# Imágenes publicadas por CI (ghcr.io/<owner>/<repo>-api|web). IMAGE_TAG: latest o el SHA de un commit.
API_IMAGE=ghcr.io/tu-usuario/arena-api
WEB_IMAGE=ghcr.io/tu-usuario/arena-web
IMAGE_TAG=latest

# Postgres (genera la contraseña con: openssl rand -base64 32 | tr -d '/+=')
POSTGRES_USER=arena
POSTGRES_PASSWORD=
POSTGRES_DB=arena

# Días que se conservan las copias diarias en ./backups
BACKUP_KEEP_DAYS=14
