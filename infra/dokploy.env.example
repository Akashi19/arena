# ===== Variables de Arena para Dokploy (pestaña "Environment" del servicio Docker Compose) =====
# Genera una copia con secretos aleatorios: ./infra/scripts/dokploy-env.sh > infra/dokploy.env
# Las URL son las de la pestaña "Domains" (web → 3000, api → 4100, storage → 8333), sin barra final.

PUBLIC_WEB_URL=http://arena-web-XXXX.traefik.me
PUBLIC_API_URL=http://arena-api-XXXX.traefik.me
PUBLIC_FILES_URL=http://arena-files-XXXX.traefik.me

# Dominios traefik.me (HTTP): false. Con dominio propio y HTTPS: true
COOKIE_SECURE=false

POSTGRES_USER=arena
POSTGRES_DB=arena
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=arena-public
S3_BUCKET_PRIVATE=arena-private

# Primer SUPERADMIN (solo se crea si no existe ninguno). Después cambia la contraseña en Perfil → Seguridad
# y borra SUPERADMIN_PASSWORD de aquí.
SUPERADMIN_EMAIL=admin@arena.test
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

# Pagos de prueba sin dinero real (suscripciones y cobro de inscripciones). false en producción real.
BILLING_SANDBOX=true

# Opcional: Stripe y Mercado Pago (ver docs/DESPLIEGUE.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_MARKETPLACE_WEBHOOK_SECRET=
PAYMENTS_ENCRYPTION_KEY=
REGISTRATION_PAYMENT_HOLD_MINUTES=30
BACKUP_KEEP_DAYS=14
