{
  "name": "arena-torneos",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de gestión de torneos deportivos y eSports (monorepo)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "infra:up": "docker compose up -d db storage",
    "infra:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:reset": "npm run prisma:reset -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "ci": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@scarf/scarf": false
  }
}
