# ===== API Arena Torneos =====
NODE_ENV=production
PORT=4100
# Orígenes permitidos (CORS), separados por coma
CORS_ORIGINS=http://localhost:3100
PUBLIC_WEB_URL=http://localhost:3100

DATABASE_URL=postgresql://arena:arena_dev_password@localhost:5433/arena?schema=public

# JWT: usa valores largos y aleatorios en producción (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Almacenamiento S3-compatible (SeaweedFS local, AWS S3 / R2 en producción)
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=arena_s3_key
S3_SECRET_KEY=arena_s3_secret_dev
S3_BUCKET_PUBLIC=arena-public
S3_BUCKET_PRIVATE=arena-private
S3_FORCE_PATH_STYLE=true

# Pagos de suscripción. Un proveedor se habilita solo con su clave Y su secreto de webhook.
# Webhooks: POST {PUBLIC_API_URL}/api/billing/webhooks/stripe  ·  .../mercadopago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública de la API (Mercado Pago envía las notificaciones aquí)
PUBLIC_API_URL=https://api.tu-dominio.com
# Pago de prueba sin dinero real (por defecto activo fuera de producción)
BILLING_SANDBOX=false

# Transmisiones: dominios extra autorizados para enlaces (separados por coma, sin https://)
STREAM_EXTRA_DOMAINS=
